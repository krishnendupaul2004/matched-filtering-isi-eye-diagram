# ============================================================
# 33. MULTIPATH ISI CHANNEL
# ============================================================

path_delay = 5*sps

path_gain = 0.45

multipath_length = (
    len(tx) + path_delay
)

multipath_signal = np.zeros(
    multipath_length
)

# Direct path
multipath_signal[
    :len(tx)
] += tx

# Delayed path
multipath_signal[
    path_delay:path_delay+len(tx)
] += path_gain * tx


# ============================================================
# 34. ADD NOISE
# ============================================================

mp_power = np.mean(
    multipath_signal**2
)

mp_noise_power = (
    mp_power /
    10**(SNRdB/10)
)

mp_noise = (
    np.sqrt(mp_noise_power)
    *
    np.random.randn(
        len(multipath_signal)
    )
)

multipath_rx = (
    multipath_signal +
    mp_noise
)


# ============================================================
# 35. MATCHED FILTER AFTER MULTIPATH
# ============================================================

multipath_mf = np.convolve(
    multipath_rx,
    matched_filter,
    mode="full"
)

multipath_aligned = (
    multipath_mf[
        total_delay:
    ]
)


# ============================================================
# 36. MULTIPATH WAVEFORM
# ============================================================

plt.figure(figsize=(12,5))

plt.plot(
    multipath_aligned[:1500]
)

plt.grid(True)

plt.xlabel(
    "Sample"
)

plt.ylabel(
    "Amplitude"
)

plt.title(
    "Matched Filter Output with Multipath ISI"
)

plt.show()


# ============================================================
# 37. MULTIPATH EYE DIAGRAM
# ============================================================

plot_eye(
    multipath_aligned,
    sps
)


